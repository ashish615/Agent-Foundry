# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_foundry

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_SECRET_KEY=change-me-in-production

# ── Auth (Keycloak) ───────────────────────────────────────────────────────────
KEYCLOAK_ISSUER=http://localhost:8080/realms/agent-foundry
KEYCLOAK_ID=agent-foundry-control-plane
KEYCLOAK_SECRET=change-me-in-production
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ── Control Plane ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-foundry
